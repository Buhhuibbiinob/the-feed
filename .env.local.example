NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > API > service_role key. Only used server-side, for admin
# actions like removing a user account — never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Free key from https://www.last.fm/api/account/create — powers Trending
# Music on New Releases (Spotify's new-releases endpoint is deprecated for
# apps without their extended-quota approval).
LASTFM_API_KEY=
# Free key from https://www.themoviedb.org/settings/api — powers New Movies
# & TV on New Releases.
TMDB_API_KEY=

# Optional. Shared secret for the scheduled endpoints. All of them are
# closed (404) while this is unset, and all of them expect an
# "Authorization: Bearer $CRON_SECRET" header:
#
#   GET /api/bots/run     one round of bot activity, to keep the feed
#                         moving during quiet hours. Bots also have to be
#                         switched on in Admin > Homepage Sections.
#   GET /api/digest/run   activity digest emails. Every few hours is the
#                         intended cadence; members with nothing new are
#                         skipped, so running it often is cheap.
#   GET /api/winback/run  the nudge for members who posted once and went
#                         quiet - the ones the digest can never reach,
#                         because every line in a digest needs somebody
#                         else to have acted on them first. Once a day is
#                         plenty: the rules are measured in days, so
#                         anything more often is just no-ops.
#   GET /api/mail/run     both of the above, in order, behind one URL.
#                         This is the one vercel.json schedules, because
#                         Vercel's Hobby plan allows two cron jobs in
#                         total and the other has to be the bots. The two
#                         individual routes still work for running one by
#                         hand.
#
# Vercel supplies the header itself: set CRON_SECRET in the project's
# environment variables and its cron invocations arrive already carrying
# "Authorization: Bearer $CRON_SECRET". Crons only run against Production.
CRON_SECRET=
