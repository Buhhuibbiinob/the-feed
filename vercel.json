{
  "crons": [
    {
      "path": "/api/mail/run",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/bots/run",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/rewind",
      "destination": "/rewind/index.html"
    },
    {
      "source": "/rewind/",
      "destination": "/rewind/index.html"
    }
  ],
  "headers": [
    {
      "source": "/rewind/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
