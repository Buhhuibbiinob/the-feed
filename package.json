{
  "name": "the-feed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/check-theme-purity.mjs && node scripts/check-theme-contrast.mjs && node scripts/check-shadow-weight.mjs && node scripts/check-owner-target.mjs && npx tsx scripts/emoji-keyboard-check.ts && npx tsx scripts/profile-scope-check.ts && eslint",
    "check:owner": "node scripts/check-owner-target.mjs",
    "check:announcements": "npx tsx scripts/announcement-check.ts",
    "check:emoji": "npx tsx scripts/emoji-keyboard-check.ts",
    "check:pages": "npx tsx scripts/archived-pages-check.ts",
    "check:profilescope": "npx tsx scripts/profile-scope-check.ts",
    "check:store": "npx tsx scripts/store-check.ts",
    "check:afterpost": "npx tsx scripts/after-post-check.ts",
    "check:winback": "npx tsx scripts/winback-check.ts",
    "check:genres": "npx tsx scripts/genre-check.ts",
    "check:postcolumns": "npx tsx scripts/post-column-check.ts",
    "check:works": "npx tsx scripts/work-key-check.ts",
    "check:themes": "node scripts/check-theme-purity.mjs",
    "check:contrast": "node scripts/check-theme-contrast.mjs --verbose",
    "check:shadows": "node scripts/check-shadow-weight.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
